# Copy to .env and adjust. NEVER commit the real .env.
NODE_ENV=development

# REQUIRED in production — the app refuses to boot without it. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

PORT=3001
HOST=0.0.0.0
DB_PATH=./tickets.db
# Optional: keep uploads on a bigger / backed-up volume.
# UPLOADS_DIR=/volume1/itme/uploads

# Public URL used in WhatsApp links. Its scheme also decides whether the
# session cookie is marked Secure (https → yes, http → no).
APP_URL=http://theuniongroup.synology.me:3001
# Force the cookie flag if needed (e.g. HTTPS terminated by a proxy): true/false
# COOKIE_SECURE=

# Set when a reverse proxy (Synology DSM / nginx) is in front, so rate limits
# see the real client IP. Usually 1 (one proxy hop) or "loopback".
# TRUST_PROXY=1

# The SPA is same-origin; only list other sites that must call the API.
# CORS_ORIGINS=https://intranet.example.com

# First start on an EMPTY database: create this SuperAdmin instead of the demo
# accounts. Remove ADMIN_PASSWORD after the first successful start.
# ADMIN_EMAIL=it.admin@company.com
# ADMIN_PASSWORD=
# ADMIN_NAME=IT Administrator

# --- Notifications -----------------------------------------------------------
EMAIL_ENABLED=false

# WhatsApp via Fonnte. Messages are sent only when a token is set and
# FONNTE_ENABLED is not "false".
FONNTE_ENABLED=false
FONNTE_TOKEN=
FONNTE_DEVICE=
FONNTE_ENDPOINT=https://api.fonnte.com/send
# Technician group chat ids (…@g.us). Department-specific ids win over the
# shared one.
FONNTE_WA_GROUP=
FONNTE_WA_GROUP_IT=
FONNTE_WA_GROUP_ME=
