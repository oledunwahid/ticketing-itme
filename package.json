{
  "name": "ticketing-app",
  "version": "1.0.0",
  "description": "IT-ME ticketing system for IT & Mechanical operations (Node.js, Express, SQLite).",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/api.test.js",
    "check": "npm run lint && npm test",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
