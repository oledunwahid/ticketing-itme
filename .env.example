# Copy to .env for local dev. NEVER commit the real .env.
NODE_ENV=development

# REQUIRED in production — the app refuses to boot in prod without it.
JWT_SECRET=replace-with-a-long-random-secret

PORT=3001

# --- Notifications (all disabled by default; safe for prototype/demo) ---
EMAIL_ENABLED=false

# WhatsApp via Fonnte — leave disabled until you are ready to send real messages.
FONNTE_ENABLED=false
FONNTE_TOKEN=
FONNTE_DEVICE=
FONNTE_ENDPOINT=https://api.fonnte.com/send
